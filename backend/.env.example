# WAJIB diisi — jangan pakai nilai placeholder (gunakan nilai unik dan aman)
DJANGO_ENV=development
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ────────────────────────────────────────────────────────────────
DB_NAME=lumina
DB_USER=lumina
DB_PASSWORD=lumina_secret
DB_HOST=127.0.0.1
DB_PORT=5433

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Email ───────────────────────────────────────────────────────────────────
# WAJIB diisi jika menggunakan EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ── Embedding Model Cache ───────────────────────────────────────────────────
# Folder untuk menyimpan cache model embedding (HuggingFace / sentence-transformers)
# Biarkan kosong untuk menggunakan default (~/.cache/huggingface)
# Untuk Docker, set ke /app/models dan mount volume dari host
EMBEDDING_MODEL_CACHE_DIR=

# ── RAG / Retrieval & Reranker ──────────────────────────────────────────────
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_INPUT_K=10
RERANKER_TIMEOUT_SECONDS=5.0
