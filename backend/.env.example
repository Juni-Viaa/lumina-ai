# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_ENV=development
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ────────────────────────────────────────────────────────────────
DB_NAME=lumina
DB_USER=lumina
DB_PASSWORD=lumina_secret
DB_HOST=127.0.0.1
DB_PORT=5433

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Ulangi sekali saat koneksi Gemini terputus atau layanan memberi error 5xx.
GEMINI_MAX_ATTEMPTS=2
GEMINI_RETRY_DELAY_SECONDS=1

# Kirim gambar dokumen ke Gemini untuk analisis visual (opt-in).
VISION_ENABLED=False
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
VISION_DOCX_MAX_IMAGES=15

# Mode ringan untuk OCR lokal. Aktifkan dua opsi pertama hanya untuk scan
# yang miring, terbalik, melengkung, atau diambil dari sudut tajam.
OCR_USE_DOC_ORIENTATION=False
OCR_USE_DOC_UNWARPING=False
OCR_USE_TEXTLINE_ORIENTATION=True
# ── Embedding Model Cache ───────────────────────────────────────────────────
# Folder untuk menyimpan cache model embedding (HuggingFace / sentence-transformers)
# Biarkan kosong untuk menggunakan default (~/.cache/huggingface)
# Untuk Docker, set ke /app/models dan mount volume dari host
EMBEDDING_MODEL_CACHE_DIR=
